import pandas as pd
import statsmodels.api as sm
from scipy.stats import f

data = pd.read_csv("AS3Data.txt", header=None)
Y = data.iloc[:, 0]
X = data.iloc[:, 1:]
X = sm.add_constant(X)
full_model = sm.OLS(Y, X).fit()
params_full = full_model.params
equation_full = f"y = {params_full['const']:.4f}"
for var in params_full.index:
    if var == "const":
        continue
    equation_full += f" + {params_full[var]:.4f}X{var}"
print("\nFull Regression Equation:")
print(equation_full)

def backward_elimination(Y, X, alpha=0.05):
    variables = list(X.columns)
    while True:
        full_model = sm.OLS(Y, X).fit()
        s2 = full_model.ssr / full_model.df_resid
        ess_full = full_model.ess
        df_resid = full_model.df_resid
        worst_var = None
        lowest_F = None
        for var in variables:
            if var == "const":
                continue
            reduced_X = X.drop(columns=[var])
            reduced_model = sm.OLS(Y, reduced_X).fit()
            ess_reduced = reduced_model.ess
            delta_ess = ess_full - ess_reduced
            Fstat = (delta_ess / 1) / s2
            print(f"Variable {var}: ΔESS={delta_ess:.4f}, F={Fstat:.4f}")
            if lowest_F is None or Fstat < lowest_F:
                lowest_F = Fstat
                worst_var = var
        Fcrit = f.ppf(1-alpha, dfn=1, dfd=df_resid)
        print(f"Critical F = {Fcrit:.4f}")
        if lowest_F is None:
            break
        if lowest_F < Fcrit:
            print(f"Removing {worst_var} (F={lowest_F:.4f} < Fcrit)")
            variables.remove(worst_var)
            X = X.drop(columns=[worst_var])
        else:
            break
    return sm.OLS(Y, X).fit()

final_model = backward_elimination(Y, X)
params = final_model.params
equation = f"y = {params['const']:.4f}"
for var in params.index:
    if var == "const":
        continue
    equation += f" + {params[var]:.4f}X{var}"
print("\nFinal Regression Equation:")
print(equation)
